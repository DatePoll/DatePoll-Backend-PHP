{
    "name": "datepoll/datepoll",
    "description": "DatePoll is a community management application.",
    "keywords": [
        "clubs",
        "management",
        "polls",
        "emails"
    ],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": ">=8.3.37 <8.4",
        "ext-fileinfo": "*",
        "ext-iconv": "*",
        "ext-imap": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "firebase/php-jwt": "7.2.1",
        "illuminate/mail": "11.51.0",
        "illuminate/redis": "11.51.0",
        "jsvrcek/ics": "0.8.6",
        "laravel/lumen-framework": "11.2.0",
        "league/flysystem": "3.36.0",
        "league/flysystem-local": "3.35.3",
        "neitanod/forceutf8": "2.0.4",
        "php-imap/php-imap": "6.0.0",
        "predis/predis": "3.7.0",
        "rap2hpoutre/laravel-log-viewer": "2.5.0"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "3.7.0",
        "fakerphp/faker": "1.24.1",
        "friendsofphp/php-cs-fixer": "3.95.27",
        "jetbrains/phpstorm-attributes": "1.3",
        "mockery/mockery": "1.6.15",
        "larastan/larastan": "3.13.0",
        "phpunit/phpunit": "10.5.66"
    },
    "autoload": {
        "classmap": [
            "database/seeds",
            "database/factories",
            "database/migrations"
        ],
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "classmap": [
            "tests/"
        ]
    },
    "scripts": {
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "phpunit"
        ],
        "analyse": "phpstan analyse --memory-limit=1G",
        "lint": "find app bootstrap config database routes tests -name '*.php' -print0 | xargs -0 -n1 php -l",
        "format": "php-cs-fixer fix --using-cache=no",
        "audit-dependencies": "@composer audit --locked"
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.3.37"
        },
        "allow-plugins": false,
        "policy": {
            "advisories": {
                "ignore-id": {
                    "PKSA-zwc5-qtrz-zm1n": "CVE-2026-48019: email validation fix backported in App\\Validation\\Validator; raw outbound address/name controls rejected in ADatePollMailable. See README and MailAddressSafetyTest. Lumen 11 has no patched upstream release."
                }
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
