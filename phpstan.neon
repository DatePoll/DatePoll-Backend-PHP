includes:
    - phpstan-baseline.neon
    - ./vendor/larastan/larastan/extension.neon

parameters:
    # Lumen does not support Laravel configuration caching.
    noEnvCallsOutsideOfConfig: false
    configDirectories:
        - config
    paths:
        - app

    level: 5

    excludePaths:
        - ./routes/*
        - ./vendor/*
